# -----------------------------------------------------------------------------
# AI Chat Bot — environment template
# Copy to `.env` and fill in. Never commit the real `.env`.
# -----------------------------------------------------------------------------

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_COST=12

# ---- Primary DB (Postgres) ---------------------------------------------------
DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot

# ---- Optional alternative doc-metadata stores --------------------------------
# Leave blank unless you choose one of these as the metadata store.
MONGODB_URI=
MYSQL_URL=

# ---- Cache / queue (Redis) ---------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Object storage (S3 / MinIO) ---------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatbot-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Vector store ------------------------------------------------------------
# pinecone | pgvector
VECTOR_STORE=pgvector
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENVIRONMENT=

# ---- LLM / embeddings --------------------------------------------------------
# openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Override base URL to point at any OpenAI-compatible server (e.g. local Ollama).
# Leave blank to use OpenAI cloud. For Ollama running on the Docker host:
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# ---- Upload limits -----------------------------------------------------------
UPLOAD_MAX_MB=25
UPLOAD_ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/csv,text/plain

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=info
